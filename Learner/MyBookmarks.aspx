<%@ Page Title="My bookmarks" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="MyBookmarks.aspx.cs" Inherits="LearningSystem.Learner.MyBookmarks" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<h1>My bookmarks</h1><p><a href="MyCourses.aspx">Back to my courses</a></p>
<div class="table-scroll" role="region" aria-label="Bookmarked materials" tabindex="0"><asp:GridView ID="gvBookmarks" runat="server" AutoGenerateColumns="false" Caption="Your bookmarked materials" UseAccessibleHeader="true" EmptyDataText="You have no bookmarks yet." OnRowCommand="BookmarkCommand"><Columns>
<asp:BoundField DataField="CourseTitle" HeaderText="Course" HtmlEncode="true" /><asp:BoundField DataField="Title" HeaderText="Material" HtmlEncode="true" />
<asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:HyperLink ID="lnkOpen" runat="server" Text="Open lesson" NavigateUrl='<%# "~/Member/Lesson.aspx?id="+Eval("MaterialID") %>' Visible='<%# (bool)Eval("Available") %>' /><asp:Literal ID="litUnavailable" runat="server" Text="Currently unavailable — re-enrol or wait for publication." Visible='<%# !(bool)Eval("Available") %>' /><asp:Button ID="btnRemove" runat="server" Text="Remove bookmark" CommandName="RemoveBookmark" CommandArgument='<%# Eval("MaterialID") %>' Visible='<%# (bool)Eval("Available") %>' OnClientClick="return confirm('Remove this bookmark?');" /></ItemTemplate></asp:TemplateField>
</Columns></asp:GridView></div></asp:Content>
