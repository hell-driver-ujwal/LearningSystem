<%@ Page Title="Course results" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Results.aspx.cs" Inherits="LearningSystem.Teacher.Results" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><h1>Course results</h1>
<section class="form-card"><h2>Filter results</h2><asp:ValidationSummary ID="vsFilters" runat="server" ValidationGroup="Filter" />
<div class="field"><asp:Label ID="lblCourse" runat="server" AssociatedControlID="ddlCourse" Text="Course" /><asp:DropDownList ID="ddlCourse" runat="server" AutoPostBack="true" OnSelectedIndexChanged="CourseChanged" /></div>
<div class="field"><asp:Label ID="lblActivity" runat="server" AssociatedControlID="ddlActivity" Text="Activity" /><asp:DropDownList ID="ddlActivity" runat="server" /></div>
<div class="actions"><asp:Button ID="btnFilter" runat="server" Text="Apply filters" ValidationGroup="Filter" OnClick="ApplyFilters" /><asp:Button ID="btnCancel" runat="server" Text="Cancel / clear filters" CausesValidation="false" OnClick="ClearFilters" /><a href="Dashboard.aspx">Dashboard</a></div></section>
<h2>Submitted attempts</h2>
<div class="table-scroll" role="region" aria-label="Submitted attempts, newest first (UTC)" tabindex="0"><asp:GridView ID="gvResults" runat="server" AutoGenerateColumns="false" Caption="Submitted attempts, newest first (UTC)" UseAccessibleHeader="true" EmptyDataText="No submitted attempts match these filters." AllowPaging="true" PageSize="10" OnPageIndexChanging="ChangePage"><Columns>
<asp:BoundField DataField="CourseTitle" HeaderText="Course" HtmlEncode="true" /><asp:BoundField DataField="Title" HeaderText="Activity" HtmlEncode="true" /><asp:BoundField DataField="ActivityType" HeaderText="Type" />
<asp:BoundField DataField="FullName" HeaderText="Learner" HtmlEncode="true" />
<asp:BoundField DataField="SubmittedAt" HeaderText="Submitted (UTC)" DataFormatString="{0:yyyy-MM-dd HH:mm:ss}" /><asp:BoundField DataField="Summary" HeaderText="Result" HtmlEncode="true" />
<asp:TemplateField HeaderText="Details"><ItemTemplate><asp:HyperLink ID="lnkResult" runat="server" Text='<%# Eval("LinkText") %>' NavigateUrl='<%# Eval("ResultUrl") %>' Visible='<%# !String.IsNullOrEmpty((string)Eval("ResultUrl")) %>' /></ItemTemplate></asp:TemplateField>
</Columns></asp:GridView></div>
<h2>Quiz and game scores</h2><p>Each row summarises one learner's saved attempts on one activity. Confidence and scenario outcomes are not percentage scores.</p>
<div class="table-scroll" role="region" aria-label="Quiz and game attempt counts, best, latest and average scores" tabindex="0"><asp:GridView ID="gvScores" runat="server" AutoGenerateColumns="false" Caption="Quiz and game attempt counts, best, latest and average scores" UseAccessibleHeader="true" EmptyDataText="No quiz or game scores match these filters."><Columns><asp:BoundField DataField="CourseTitle" HeaderText="Course" HtmlEncode="true" /><asp:BoundField DataField="Title" HeaderText="Activity" HtmlEncode="true" /><asp:BoundField DataField="FullName" HeaderText="Learner" HtmlEncode="true" /><asp:BoundField DataField="Attempts" HeaderText="Attempts" /><asp:BoundField DataField="BestScore" HeaderText="Best (%)" DataFormatString="{0:F2}" /><asp:BoundField DataField="LatestScore" HeaderText="Latest (%)" DataFormatString="{0:F2}" /><asp:BoundField DataField="AverageScore" HeaderText="Average (%)" DataFormatString="{0:F2}" /></Columns></asp:GridView></div><p>Select a self-assessment or scenario activity to see its class summary. <asp:HyperLink ID="lnkLearners" runat="server" Text="Enrolled learner names" Visible="false" /></p>
<asp:Panel ID="pnlSA" runat="server" Visible="false"><h2>Class confidence by statement</h2><div class="table-scroll" role="region" aria-label="Average statement ratings across submitted attempts (1–5)" tabindex="0"><asp:GridView ID="gvSA" runat="server" AutoGenerateColumns="false" Caption="Average statement ratings across submitted attempts (1–5)" UseAccessibleHeader="true" EmptyDataText="No statements yet."><Columns><asp:BoundField DataField="StatementText" HeaderText="Statement" HtmlEncode="true" /><asp:BoundField DataField="Responses" HeaderText="Ratings" /><asp:BoundField DataField="AverageDisplay" HeaderText="Average confidence / 5" /></Columns></asp:GridView></div></asp:Panel>
<asp:Panel ID="pnlScenario" runat="server" Visible="false"><h2>Scenario outcomes</h2><div class="table-scroll" role="region" aria-label="Saved attempts by ending step and outcome" tabindex="0"><asp:GridView ID="gvScenario" runat="server" AutoGenerateColumns="false" Caption="Saved attempts by ending step and outcome" UseAccessibleHeader="true" EmptyDataText="No completed scenario attempts yet."><Columns><asp:BoundField DataField="StepID" HeaderText="Ending ID" /><asp:BoundField DataField="StepText" HeaderText="Ending" HtmlEncode="true" /><asp:BoundField DataField="Outcome" HeaderText="Outcome" /><asp:BoundField DataField="Attempts" HeaderText="Attempts" /></Columns></asp:GridView></div></asp:Panel><h2>Charts</h2><asp:Literal ID="litCharts" runat="server" /><script src="../Scripts/charts.js" defer></script></asp:Content>

