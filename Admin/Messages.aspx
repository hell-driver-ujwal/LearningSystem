<%@ Page Title="Messages" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Messages.aspx.cs" Inherits="LearningSystem.Admin.Messages" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><div class="page-header"><div><h1>Messages</h1><p class="intro">Messages sent through the Contact page. Reply to the sender by email.</p></div></div>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="form-card"><h2><asp:Literal ID="litSubject" runat="server" Mode="Encode" /></h2><p><asp:Literal ID="litSender" runat="server" Mode="Encode" /></p><p class="preserve-lines"><asp:Literal ID="litBody" runat="server" Mode="Encode" /></p><asp:Button ID="btnRead" runat="server" Text="Mark as read" OnClick="MarkRead" /><a href="Messages.aspx">Back to inbox</a></asp:Panel>
<div class="table-scroll" role="region" aria-label="Contact messages" tabindex="0"><asp:GridView ID="gvMessages" runat="server" AutoGenerateColumns="false" Caption="Contact messages (UTC)" UseAccessibleHeader="true" EmptyDataText="No contact messages yet." AllowPaging="true" PageSize="10" OnPageIndexChanging="ChangePage" OnRowCommand="MessageCommand"><Columns>
<asp:BoundField DataField="SenderName" HeaderText="Sender" HtmlEncode="true" /><asp:BoundField DataField="SenderEmail" HeaderText="Email" HtmlEncode="true" /><asp:BoundField DataField="Subject" HeaderText="Subject" HtmlEncode="true" /><asp:BoundField DataField="SentDate" HeaderText="Sent (UTC)" DataFormatString="{0:yyyy-MM-dd HH:mm}" /><asp:CheckBoxField DataField="IsRead" HeaderText="Read" />
<asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:HyperLink ID="lnkOpen" runat="server" Text="Open" NavigateUrl='<%# "Messages.aspx?id="+Eval("MessageID") %>' /><asp:Button ID="btnDelete" runat="server" Text="Delete" CommandName="RemoveMessage" CommandArgument='<%# Eval("MessageID") %>' OnClientClick="return confirm('Delete this contact message?');" /></ItemTemplate></asp:TemplateField>
</Columns></asp:GridView></div></asp:Content>
