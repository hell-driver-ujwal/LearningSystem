<%@ Page Title="Manage FAQs" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="FAQ.aspx.cs" Inherits="LearningSystem.Admin.FAQ" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><h1>Manage FAQs</h1><p><a href="Dashboard.aspx">Admin dashboard</a> · <a href="../Help.aspx">View Help</a></p><section class="form-card"><h2>Add or edit FAQ</h2><asp:ValidationSummary ID="vsForm" runat="server" ValidationGroup="Save" /><div class="field"><asp:Label ID="lblQuestion" runat="server" AssociatedControlID="txtQuestion" Text="Question" /><asp:TextBox ID="txtQuestion" runat="server" TextMode="MultiLine" /><asp:RequiredFieldValidator ID="rfvQuestion" runat="server" ControlToValidate="txtQuestion" ValidationGroup="Save" ErrorMessage="Enter Question." /><asp:RegularExpressionValidator ID="revQuestion" runat="server" ControlToValidate="txtQuestion" ValidationExpression="^[\s\S]{5,200}$" ValidationGroup="Save" ErrorMessage="Question must be 5–200 characters." /></div><div class="field"><asp:Label ID="lblAnswer" runat="server" AssociatedControlID="txtAnswer" Text="Answer" /><asp:TextBox ID="txtAnswer" runat="server" TextMode="MultiLine" /><asp:RequiredFieldValidator ID="rfvAnswer" runat="server" ControlToValidate="txtAnswer" ValidationGroup="Save" ErrorMessage="Enter Answer." /><asp:RegularExpressionValidator ID="revAnswer" runat="server" ControlToValidate="txtAnswer" ValidationExpression="^[\s\S]{10,2000}$" ValidationGroup="Save" ErrorMessage="Answer must be 10–2000 characters." /></div><div class="field"><asp:Label ID="lblAudience" runat="server" AssociatedControlID="ddlAudience" Text="Audience" /><asp:DropDownList ID="ddlAudience" runat="server"><asp:ListItem>All</asp:ListItem><asp:ListItem>Learner</asp:ListItem><asp:ListItem>Teacher</asp:ListItem></asp:DropDownList></div>
<div class="field"><asp:Label ID="lblOrder" runat="server" AssociatedControlID="txtOrder" Text="Order (1–100)" /><asp:TextBox ID="txtOrder" runat="server" TextMode="Number" Text="1" /><asp:RequiredFieldValidator ID="rfvOrder" runat="server" ControlToValidate="txtOrder" ValidationGroup="Save" ErrorMessage="Enter an order." /><asp:RangeValidator ID="rvOrder" runat="server" ControlToValidate="txtOrder" Type="Integer" MinimumValue="1" MaximumValue="100" ValidationGroup="Save" ErrorMessage="Order must be 1–100." /></div>
<div class="actions"><asp:Button ID="btnSave" runat="server" Text="Save FAQ" ValidationGroup="Save" OnClick="Save" /><asp:Button ID="btnCancel" runat="server" Text="Cancel" CausesValidation="false" OnClick="Cancel" /></div></section>
<div class="table-scroll" role="region" aria-label="FAQs" tabindex="0"><asp:GridView ID="gvFAQ" runat="server" AutoGenerateColumns="false" Caption="FAQs in display order" UseAccessibleHeader="true" EmptyDataText="No FAQs yet." OnRowCommand="FAQCommand"><Columns><asp:BoundField DataField="Question" HeaderText="Question" HtmlEncode="true" /><asp:BoundField DataField="Audience" HeaderText="Audience" /><asp:BoundField DataField="SortOrder" HeaderText="Order" /><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:Button ID="btnEdit" runat="server" Text="Edit" CommandName="EditFAQ" CommandArgument='<%# Eval("FAQID") %>' ValidationGroup="Action" /><asp:Button ID="btnDelete" runat="server" Text="Delete" CommandName="RemoveFAQ" CommandArgument='<%# Eval("FAQID") %>' ValidationGroup="Delete" OnClientClick="return confirm('Delete this FAQ?');" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></asp:Content>