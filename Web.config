<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="LearningSystemDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\LearningSystem.mdf;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings file="App_Data/PaymentSettings.config">
    <add key="EsewaProductCode" value="EPAYTEST"/>
    <add key="EsewaSecretKey" value=""/>
    <add key="EsewaFormUrl" value="https://rc-epay.esewa.com.np/api/epay/main/v2/form"/>
    <add key="EsewaStatusUrl" value="https://rc.esewa.com.np/api/epay/transaction/status/"/>
    <add key="HttpsOrigin" value="https://localhost:44393/"/>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="30720"/>
    <authentication mode="Forms">
      <forms requireSSL="true" loginUrl="~/Account/Login.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies"/>
    </authentication>
    <sessionState timeout="30" cookieless="UseCookies"/>
    <httpCookies requireSSL="true" httpOnlyCookies="true" sameSite="Lax"/>
    <pages validateRequest="true" enableEventValidation="true"/>
    <customErrors mode="Off" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/AccessDenied.aspx"/>
      <error statusCode="404" redirect="~/NotFound.aspx"/>
    </customErrors>
  </system.web>
  <location path="Learner">
    <system.web>
      <authorization>
        <allow roles="Learner"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Teacher">
    <system.web>
      <authorization>
        <allow roles="Teacher"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Payment"><system.web><authorization><allow roles="Learner"/><deny users="*"/></authorization></system.web></location>
  <location path="Member">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <!-- Existing template assemblies remain referenced; no new packages are added. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" culture="neutral" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed"/>
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" culture="neutral" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" culture="neutral" publicKeyToken="eb42632606e9261f"/>
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.webServer>
    <security>
      <requestFiltering><!-- Files are served only by the authorized Media.ashx handler. --><hiddenSegments><add segment="Uploads" /></hiddenSegments>
        <requestLimits maxAllowedContentLength="31457280"/>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1"/>
      <error statusCode="404" path="/NotFound.aspx" responseMode="ExecuteURL"/>
    </httpErrors>
  </system.webServer>
</configuration>

