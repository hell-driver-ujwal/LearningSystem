<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="LearningSystemDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=LearningSystemFinal;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="HttpsOrigin" value="https://localhost:44393/"/>
    <!-- Site details shown on pages and used in sitemap.xml. The project runs locally on the address above. -->
    <add key="SiteName" value="Inkwell"/>
    <add key="SiteOrigin" value="https://localhost:44393/"/>
    <add key="ContactEmail" value="hello@inkwellacademy.com.np"/>
    <add key="ContactAddress" value="Putalisadak, Kathmandu 44600, Nepal"/>
    <add key="LastUpdated" value="1 October 2026"/>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="30720"/>
    <authentication mode="Forms">
      <forms requireSSL="true" loginUrl="~/Account/Login.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies"/>
    </authentication>
    <sessionState timeout="30" cookieless="UseCookies"/>
    <httpCookies requireSSL="true" httpOnlyCookies="true" sameSite="Lax"/>
    <pages validateRequest="true" enableEventValidation="true"/>
    <customErrors mode="On" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="403" redirect="~/AccessDenied.aspx"/>
      <error statusCode="404" redirect="~/NotFound.aspx"/>
    </customErrors>
  </system.web>
  <location path="Learner">
    <system.web>
      <authorization>
        <allow roles="Learner"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Teacher">
    <system.web>
      <authorization>
        <allow roles="Teacher,Admin"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin"/>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Payment"><system.web><authorization><allow roles="Learner"/><deny users="*"/></authorization></system.web></location>
  <location path="Member">
    <system.web>
      <authorization>
        <deny users="?"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <security>
      <requestFiltering><!-- Files are served only by the authorized Media.ashx handler. --><hiddenSegments><add segment="Uploads" /></hiddenSegments>
        <requestLimits maxAllowedContentLength="31457280"/>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1"/>
      <error statusCode="404" path="/NotFound.aspx" responseMode="ExecuteURL"/>
    </httpErrors>
    <!-- robots.txt and sitemap.xml are generated so the sitemap always lists the published courses. -->
    <handlers>
      <add name="RobotsTxt" path="robots.txt" verb="GET,HEAD" type="LearningSystem.Helpers.RobotsHandler" resourceType="Unspecified" preCondition="integratedMode"/>
      <add name="SitemapXml" path="sitemap.xml" verb="GET,HEAD" type="LearningSystem.Helpers.SitemapHandler" resourceType="Unspecified" preCondition="integratedMode"/>
    </handlers>
    <staticContent>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
      <remove fileExtension=".vtt"/>
      <mimeMap fileExtension=".vtt" mimeType="text/vtt"/>
      <remove fileExtension=".webmanifest"/>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00"/>
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>

